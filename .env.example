DATABASE_URL=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

RESEND_API_KEY=

# Sender for every outgoing email. Must be an address on a domain verified in
# your Resend dashboard. Leave it blank and mail goes out as onboarding@resend.dev,
# which only reaches your own Resend account — every customer's sign-in code is
# silently dropped. Format: "Display Name <addr@domain>".
EMAIL_FROM=

STRIPE_SECRET_KEY=

NEXTAUTH_SECRET=

NEXTAUTH_URL=

MPESA_CONSUMER_KEY=

MPESA_CONSUMER_SECRET=

MPESA_PASSKEY=

MPESA_SHORTCODE=

# "paybill" (default) or "till". Sends the wrong Safaricom transaction type
# for the account behind it otherwise — a Till (Buy Goods) number needs
# "till" here, or the STK push either fails or never reaches the merchant.
MPESA_ACCOUNT_TYPE=paybill

MPESA_ENV=sandbox

FLUTTERWAVE_SECRET_KEY=

FLUTTERWAVE_SECRET_HASH=

# Signs event ticket QR codes. Set independently of NEXTAUTH_SECRET so rotating
# a session secret does not invalidate tickets already in guests' inboxes.
TICKET_SIGNING_SECRET=

# Sign-in codes by SMS (Africa's Talking). Both are required, or neither —
# one alone silently disables SMS while looking configured.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional alphanumeric sender ID once registered with Safaricom.
AFRICASTALKING_SENDER_ID=

# Where venue listing claims land. Point at an inbox somebody reads.
CLAIMS_INBOX=

# Sign-in codes over WhatsApp (Meta Cloud API). All three are required.
# WHATSAPP_OTP_TEMPLATE must name an AUTHENTICATION-category template already
# approved in Meta Business Manager, with a copy-code button — Meta rejects
# verification codes sent as ordinary or marketing messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
