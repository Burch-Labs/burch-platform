modules = ["nodejs-24", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GITHUB_SSH_KEY = ""
EMAIL_FROM = "Burch Platform <onboarding@resend.dev>"
EMAIL_OVERRIDE_TO = "sparksnairobi@gmail.com"

[userenv.development]
NEXTAUTH_URL = "https://05bb2b28-a3ef-425a-80f7-67b96180db03-00-q70kbd0d3c1c.picard.replit.dev"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd apps/web && npm run build"]
run = ["bash", "-c", "cd apps/web && npm run start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
