{
  "name": "burch-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "postinstall": "cd apps/web && npx prisma generate"
  },
  "dependencies": {
    "caniuse-lite": "1.0.30001806"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
