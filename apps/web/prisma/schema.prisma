// Burch Platform — Complete Production Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  image         String?
  emailVerified DateTime?
  password      String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  partner           Partner?
  hotelReviews      HotelReview[]
  restaurantReviews RestaurantReview[]
  tableReservations TableReservation[]
  savedSearches     SavedSearch[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ─── Saved Searches ───────────────────────────────────────────────────────────

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  q         String   @default("")
  category  String   @default("")
  city      String   @default("")
  dateFrom  String   @default("")
  dateTo    String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_searches")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailResendRateLimit {
  email      String   @id
  lastSentAt DateTime

  @@map("email_resend_rate_limits")
}

// ─── Passwordless sign-in ────────────────────────────────────────────────────

model SignInCode {
  id         String    @id @default(cuid())
  /** Email address, or phone in 2547XXXXXXXX form. Lower-cased for email. */
  identifier String
  /** bcrypt hash. The code itself is never stored, so a database read cannot
      be turned into someone else's session. */
  codeHash   String
  expiresAt  DateTime
  /** Wrong guesses so far. A code is burned after ATTEMPT_LIMIT of them, which
      is what keeps six digits out of reach of a brute force. */
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

// ─── Partner ─────────────────────────────────────────────────────────────────

model Partner {
  id          String        @id @default(cuid())
  userId      String        @unique
  name        String
  description String?
  logoUrl     String?
  website     String?
  /**
   * Whether the partner may list publicly. APPROVED on creation — signing up
   * should not block anyone from getting their venue on the site. SUSPENDED is
   * the lever for abuse after the fact.
   */
  status      PartnerStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
  hotels      Hotel[]
  restaurants Restaurant[]
  payoutAccount PayoutAccount?

  @@map("partners")
}

// ─── Payouts ─────────────────────────────────────────────────────────────────
// Deliberately separate from Partner.status, because listing and getting paid
// are different risks. Listing a venue you do not own wastes a guest's time;
// collecting their money for it is fraud. So a partner lists the moment they
// sign up, and money only moves once a human has checked who they are.
//
// Kept in its own table rather than as columns on Partner so the identity
// documents are not loaded by every query that happens to touch a partner.

model PayoutAccount {
  id        String       @id @default(cuid())
  partnerId String       @unique
  status    PayoutStatus @default(UNVERIFIED)

  /** Registered business or individual name, as it appears on the ID or cert. */
  legalName    String?
  /** KRA PIN — the Kenyan tax identifier. */
  taxId        String?
  /** National ID or business registration number. */
  idNumber     String?

  /** Where money would go. One of the two is required to submit. */
  mpesaNumber  String?
  bankName     String?
  bankAccount  String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  /** Admin user id who approved or rejected. */
  reviewedBy   String?
  /** Shown to the partner so a rejection is actionable rather than a dead end. */
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payout_accounts")
}

enum PayoutStatus {
  /** Nothing submitted. Can list, cannot be paid. */
  UNVERIFIED
  /** Details in, awaiting a human. Still cannot be paid. */
  SUBMITTED
  /** Checked. The only state money may move in. */
  VERIFIED
  /** Checked and refused. Partner can correct and resubmit. */
  REJECTED
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String        @id @default(cuid())
  partnerId   String
  title       String
  description String?
  imageUrl    String?
  category    EventCategory @default(OTHER)
  city        String        @default("")
  location    String
  startDate   DateTime
  endDate     DateTime
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("KES")
  capacity    Int
  tags        String[]      @default([])
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookings Booking[]
  tickets  Ticket[]

  // Speeds up the common listing queries: published feed sorted by date, and city filter
  @@index([published, startDate])
  @@index([published, city])
  @@map("events")
}

// ─── Hotels ──────────────────────────────────────────────────────────────────

model Hotel {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  description  String?
  imageUrl     String?
  images       String[] @default([])
  city         String   @default("")
  location     String
  starRating   Int?
  amenities    String[] @default([])
  phone        String?
  email        String?
  website      String?
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("11:00")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner  Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  rooms    Room[]
  bookings Booking[]
  reviews  HotelReview[]

  @@index([published])
  @@map("hotels")
}

model Room {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")
  capacity    Int      @default(1)
  maxGuests   Int      @default(2)
  bedType     String?
  amenities   String[] @default([])
  quantity    Int      @default(1)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model HotelReview {
  id        String   @id @default(cuid())
  hotelId   String
  userId    String
  rating    Int
  title     String?
  comment   String
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hotel_reviews")
}

// ─── Restaurants ─────────────────────────────────────────────────────────────

model Restaurant {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  description  String?
  imageUrl     String?
  images       String[] @default([])
  city         String   @default("")
  location     String
  cuisine      String?
  cuisines     String[] @default([])
  priceRange   Int?
  phone        String?
  email        String?
  website      String?
  openingHours Json?
  amenities    String[] @default([])
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner      Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  reviews      RestaurantReview[]
  reservations TableReservation[]
  bookings     Booking[]

  @@index([published])
  @@map("restaurants")
}

model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  currency     String  @default("KES")
  category     String
  imageUrl     String?
  available    Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

model RestaurantReview {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  rating       Int
  title        String?
  comment      String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("restaurant_reviews")
}

model TableReservation {
  id           String            @id @default(cuid())
  restaurantId String
  userId       String
  date         DateTime
  partySize    Int
  name         String
  email        String
  phone        String?
  notes        String?
  status       ReservationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("table_reservations")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid())
  userId        String
  type          BookingType
  status        BookingStatus @default(PENDING)
  quantity      Int           @default(1)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("KES")
  checkIn       DateTime?
  checkOut      DateTime?
  paymentRef    String?
  paymentMethod String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  eventId      String?
  hotelId      String?
  roomId       String?
  restaurantId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?      @relation(fields: [eventId], references: [id])
  hotel      Hotel?      @relation(fields: [hotelId], references: [id])
  room       Room?       @relation(fields: [roomId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  payments   Payment[]
  tickets    Ticket[]

  @@map("bookings")
}

// ─── Payments ────────────────────────────────────────────────────────────────
// Transaction ledger for paid bookings (currently: event tickets). One row per
// payment attempt, so a failed/expired M-Pesa push can be retried without
// losing the audit trail. Booking.paymentRef/paymentMethod are set from the
// successful Payment row once one exists.

model Payment {
  id          String          @id @default(cuid())
  bookingId   String
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("KES")
  phone       String? // M-Pesa payer phone (MSISDN)
  providerRef String? // Daraja CheckoutRequestID / Flutterwave tx_ref
  receiptRef  String? // Daraja MpesaReceiptNumber / Flutterwave transaction_id, set on success
  rawCallback Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([provider, providerRef])
  @@map("payments")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum EventCategory {
  MUSIC
  SPORTS
  ARTS
  FOOD_DRINK
  TECH
  BUSINESS
  COMEDY
  FILM
  EDUCATION
  OTHER
}

enum BookingType {
  EVENT
  HOTEL
  RESTAURANT
}

// ─── Tickets ─────────────────────────────────────────────────────────────────
// One row per admitted person, not per booking: a party of four gets four
// tickets, each independently named and each scannable exactly once. That is
// what makes a ticket transferable to a friend without handing over the whole
// booking, and what stops one screenshot admitting the entire group.
//
// No secret is stored here. The QR carries an HMAC of the ticket id signed with
// TICKET_SIGNING_SECRET, so forging one means forging the signature; this table
// only answers "has it already been used".

model Ticket {
  id           String       @id @default(cuid())
  bookingId    String
  eventId      String
  /** 1..n within the booking — printed as "Ticket 2 of 4". */
  serial       Int
  /** Who is coming. Null until the buyer names them; the ticket still admits. */
  attendeeName String?
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  /** User id of the organiser or gate staff who scanned it. */
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serial])
  @@index([eventId, status])
  @@map("tickets")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  /** Refunded, or cancelled after issue. Never admits. */
  VOID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  MPESA
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
