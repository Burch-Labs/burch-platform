// Burch Platform — Complete Production Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  /** Either of these can identify an account at sign-in, so both must be
      unique. Postgres allows many nulls in a unique column, so accounts
      without a phone are unaffected. */
  email         String    @unique
  name          String?
  phone         String?   @unique
  image         String?
  emailVerified DateTime?
  password      String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  partner           Partner?
  hotelReviews      HotelReview[]
  restaurantReviews RestaurantReview[]
  tableReservations TableReservation[]
  savedSearches     SavedSearch[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ─── Saved Searches ───────────────────────────────────────────────────────────

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  q         String   @default("")
  category  String   @default("")
  city      String   @default("")
  dateFrom  String   @default("")
  dateTo    String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_searches")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailResendRateLimit {
  email      String   @id
  lastSentAt DateTime

  @@map("email_resend_rate_limits")
}

// ─── Passwordless sign-in ────────────────────────────────────────────────────

model SignInCode {
  id         String    @id @default(cuid())
  /** Email address, or phone in 2547XXXXXXXX form. Lower-cased for email. */
  identifier String
  /** bcrypt hash. The code itself is never stored, so a database read cannot
      be turned into someone else's session. */
  codeHash   String
  expiresAt  DateTime
  /** Wrong guesses so far. A code is burned after ATTEMPT_LIMIT of them, which
      is what keeps six digits out of reach of a brute force. */
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

// ─── Partner ─────────────────────────────────────────────────────────────────

model Partner {
  id          String        @id @default(cuid())
  userId      String        @unique
  name        String
  description String?
  logoUrl     String?
  website     String?
  /**
   * Whether the partner may list publicly. APPROVED on creation — signing up
   * should not block anyone from getting their venue on the site. SUSPENDED is
   * the lever for abuse after the fact.
   */
  status      PartnerStatus @default(APPROVED)
  /** Set together with status SUSPENDED. The reason is shown to the partner,
      because a suspension they cannot understand is one they cannot fix. */
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedBy     String?
  /**
   * Percentage of each sale the platform keeps; the partner keeps the rest.
   * 5.00 = 5%. Defaults to the standard rate — set individually only when a
   * partner has actually negotiated a different one, so a bare list of
   * partners doesn't read as if everyone's rate was hand-picked.
   */
  commissionRate    Decimal   @default(5.00) @db.Decimal(5, 2)
  commissionSetAt   DateTime?
  commissionSetBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
  hotels      Hotel[]
  restaurants Restaurant[]
  clubs       Club[]
  payoutAccount PayoutAccount?

  @@map("partners")
}

// ─── Payouts ─────────────────────────────────────────────────────────────────
// Deliberately separate from Partner.status, because listing and getting paid
// are different risks. Listing a venue you do not own wastes a guest's time;
// collecting their money for it is fraud. So a partner lists the moment they
// sign up, and money only moves once a human has checked who they are.
//
// Kept in its own table rather than as columns on Partner so the identity
// documents are not loaded by every query that happens to touch a partner.

model PayoutAccount {
  id        String       @id @default(cuid())
  partnerId String       @unique
  status    PayoutStatus @default(UNVERIFIED)

  /** Registered business or individual name, as it appears on the ID or cert. */
  legalName    String?
  /** KRA PIN — the Kenyan tax identifier. */
  taxId        String?
  /** National ID or business registration number. */
  idNumber     String?

  /** Where money would go. One of the two is required to submit. */
  mpesaNumber  String?
  bankName     String?
  bankAccount  String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  /** Admin user id who approved or rejected. */
  reviewedBy   String?
  /** Shown to the partner so a rejection is actionable rather than a dead end. */
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payout_accounts")
}

enum PayoutStatus {
  /** Nothing submitted. Can list, cannot be paid. */
  UNVERIFIED
  /** Details in, awaiting a human. Still cannot be paid. */
  SUBMITTED
  /** Checked. The only state money may move in. */
  VERIFIED
  /** Checked and refused. Partner can correct and resubmit. */
  REJECTED
}

// ─── Clubs & leisure ─────────────────────────────────────────────────────────
// Golf and country clubs do not fit either existing type. A hotel sells nights
// and a restaurant sells covers; a club sells a round, and mostly to its own
// members. Forcing one into the hotel model would print an empty rate table
// under a "Book a room" button that means nothing here.
//
// The field that actually decides whether a listing is useful is `access`: a
// reader wants to know whether they can play at all before they care about the
// fee. Short-term rentals deliberately do not live here — they sell nights with
// a calendar and guest limits, which is the hotel shape, not this one.

model Club {
  id          String       @id @default(cuid())
  partnerId   String
  name        String
  description String?
  city        String
  location    String
  category    ClubCategory @default(GOLF)
  access      ClubAccess   @default(BY_ARRANGEMENT)

  /** Golf specifics. Null on clubs without a course. */
  holes       Int?
  par         Int?

  /** Indicative weekday visitor green fee, for orientation not for booking. */
  visitorFee  Decimal?     @db.Decimal(10, 2)
  currency    String       @default("KES")
  /** Free text for the caveats a fee cannot carry — competition days, dress. */
  visitorNotes String?

  phone     String?
  email     String?
  website   String?
  imageUrl  String?
  images    String[] @default([])
  amenities String[] @default([])
  published Boolean  @default(false)
  /**
   * Whether the venue itself has confirmed these details.
   *
   * False on everything we seeded. Seeded contact details are our research, not
   * the venue's word, and a plausible-looking wrong number is worse than no
   * number — someone dials it and reaches a stranger. The UI presents details
   * as actionable only when this is true; otherwise it says so and offers the
   * venue a way to correct them.
   */
  verified     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([city, published])
  @@map("clubs")
}

enum ClubCategory {
  GOLF
  COUNTRY
  SPORTS
  POLO
  YACHT
}

enum ClubAccess {
  /** Members and their guests only. A visitor cannot simply turn up. */
  MEMBERS_ONLY
  /** Visitors can play, but must call ahead. The common case in Kenya. */
  BY_ARRANGEMENT
  /** Green fee at the desk, no introduction needed. */
  VISITORS_WELCOME
}

// ─── Venue claims ────────────────────────────────────────────────────────────
// Someone saying they work at a venue we listed from public information.
//
// Stored rather than only emailed. A claim that exists solely as a message in
// an inbox is one nobody can hand over, search, or count — and these are the
// only inbound partner leads the platform generates, so losing them to an
// unread inbox loses the one mechanism that closes the unverified-listing gap.

model VenueClaim {
  id        String      @id @default(cuid())
  venueType VenueType
  venueId   String
  /** Denormalised so a claim stays readable if the listing is later removed. */
  venueName String

  contactName String
  role        String
  workEmail   String
  phone       String
  /** The booking page they say is theirs, if they gave one. */
  website     String?

  status      ClaimStatus @default(NEW)
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([venueType, venueId])
  @@map("venue_claims")
}

enum VenueType {
  HOTEL
  RESTAURANT
  CLUB
}

enum ClaimStatus {
  /** Nobody has looked at it. */
  NEW
  /** Someone is working it. */
  CONTACTED
  /** Confirmed — the listing has been handed over. */
  APPROVED
  /** Not who they said they were, or no longer relevant. */
  REJECTED
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String        @id @default(cuid())
  partnerId   String
  title       String
  description String?
  imageUrl    String?
  /** Additional photos beyond the cover image, same convention as Hotel/Restaurant. */
  images      String[]      @default([])
  category    EventCategory @default(OTHER)
  city        String        @default("")
  location    String
  startDate   DateTime
  endDate     DateTime
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("KES")
  capacity    Int
  tags        String[]      @default([])
  /** Incremented once per public detail-page view. Rough interest signal for
      the admin event report, not a deduplicated analytics count. */
  viewCount   Int           @default(0)
  /**
   * Visible to the public. Distinct from approvalStatus: an event only
   * reaches APPROVED, and only then gets published, once reviewed — but
   * published stays the single field every listing query already filters
   * on, so approval doesn't change how the rest of the app finds events.
   */
  published   Boolean       @default(false)
  /** Curated by an admin for the homepage "Top Picks" row. Purely editorial —
      unrelated to published/approvalStatus. */
  isFeatured  Boolean       @default(false)
  /**
   * APPROVED by default — an existing partner creating an event through
   * their own dashboard is already a vetted business and publishes
   * instantly, same as today. PENDING is set explicitly only by the public
   * submission path, where the submitter's identity hasn't been vetted at
   * all and a human needs to look at it first.
   */
  approvalStatus  EventApprovalStatus @default(APPROVED)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  /** When the submitter accepted the organizer terms. Required to submit
      through the public path; not asked of an existing partner, who agreed
      to the same terms once, at signup. */
  termsAcceptedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  tickets       Ticket[]
  tiers         TicketTier[]
  discountCodes DiscountCode[]

  // Speeds up the common listing queries: published feed sorted by date, and city filter
  @@index([published, startDate])
  @@index([published, city])
  // Homepage "Top Picks" row
  @@index([published, isFeatured])
  // The admin review queue's whole query is "find everything PENDING."
  @@index([approvalStatus])
  @@map("events")
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Ticket tiers & discount codes ──────────────────────────────────────────
// Event.price/capacity stay as the fallback for an event with no tiers — a
// tier is an opt-in refinement, not a replacement, so every event created
// before this existed keeps working unchanged.
//
// Deliberately no stored "sold" counter here. reserveEventBooking already
// proves the right pattern for this exact problem: a Serializable
// transaction with a live aggregate at booking time, not a counter that
// needs +1/-1 discipline across booking, cancellation and payment-failure
// paths kept in sync forever. Sold count for a tier is computed the same way.

model TicketTier {
  id         String    @id @default(cuid())
  eventId    String
  name       String
  price      Decimal   @db.Decimal(10, 2)
  currency   String    @default("KES")
  capacity   Int
  /** Both optional: a tier with neither is on sale whenever the event is. */
  salesStart DateTime?
  salesEnd   DateTime?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([eventId, isActive, sortOrder])
  @@map("ticket_tiers")
}

model DiscountCode {
  id        String       @id @default(cuid())
  /** Null = platform-wide, usable at checkout for any event. */
  eventId   String?
  code      String       @unique
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  /**
   * Global cap, unlike tier capacity: this is a "don't hand out unlimited
   * free money" ceiling, not an oversell-prevention mechanism, so a stored
   * counter carries much less risk here than the same idea would for a tier.
   */
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([code])
  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ─── Hotels ──────────────────────────────────────────────────────────────────

model Hotel {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  description  String?
  imageUrl     String?
  images       String[] @default([])
  city         String   @default("")
  location     String
  starRating   Int?
  amenities    String[] @default([])
  phone        String?
  email        String?
  website      String?
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("11:00")
  published    Boolean  @default(false)
  /**
   * Whether the venue itself has confirmed these details.
   *
   * False on everything we seeded. Seeded contact details are our research, not
   * the venue's word, and a plausible-looking wrong number is worse than no
   * number — someone dials it and reaches a stranger. The UI presents details
   * as actionable only when this is true; otherwise it says so and offers the
   * venue a way to correct them.
   */
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner    Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  rooms      Room[]
  bookings   Booking[]
  reviews    HotelReview[]
  happenings HotelHappening[]

  @@index([published])
  @@map("hotels")
}

// What's on at a hotel's restaurant right now — brunch, a live band, a
// seasonal menu — as opposed to Room, which is what's bookable year-round.
// Deliberately time-bounded and disposable: a happening is meant to be
// swapped out "now and then" as the hotel's own promotions change, not
// curated once and left stale like the rest of the seeded listing data.
model HotelHappening {
  id          String    @id @default(cuid())
  hotelId     String
  title       String
  description String?
  flyerUrl    String?
  startsAt    DateTime?
  endsAt      DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, published])
  @@map("hotel_happenings")
}

model Room {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")
  capacity    Int      @default(1)
  maxGuests   Int      @default(2)
  bedType     String?
  amenities   String[] @default([])
  quantity    Int      @default(1)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model HotelReview {
  id        String   @id @default(cuid())
  hotelId   String
  userId    String
  rating    Int
  title     String?
  comment   String
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hotel_reviews")
}

// ─── Restaurants ─────────────────────────────────────────────────────────────

model Restaurant {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  description  String?
  imageUrl     String?
  images       String[] @default([])
  city         String   @default("")
  location     String
  cuisine      String?
  cuisines     String[] @default([])
  priceRange   Int?
  phone        String?
  email        String?
  website      String?
  openingHours Json?
  amenities    String[] @default([])
  published    Boolean  @default(false)
  /**
   * Whether the venue itself has confirmed these details.
   *
   * False on everything we seeded. Seeded contact details are our research, not
   * the venue's word, and a plausible-looking wrong number is worse than no
   * number — someone dials it and reaches a stranger. The UI presents details
   * as actionable only when this is true; otherwise it says so and offers the
   * venue a way to correct them.
   */
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner      Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  reviews      RestaurantReview[]
  reservations TableReservation[]
  bookings     Booking[]

  @@index([published])
  @@map("restaurants")
}

model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  currency     String  @default("KES")
  category     String
  imageUrl     String?
  available    Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

model RestaurantReview {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  rating       Int
  title        String?
  comment      String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("restaurant_reviews")
}

model TableReservation {
  id           String            @id @default(cuid())
  restaurantId String
  userId       String
  date         DateTime
  partySize    Int
  name         String
  email        String
  phone        String?
  notes        String?
  status       ReservationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("table_reservations")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid())
  userId        String
  type          BookingType
  status        BookingStatus @default(PENDING)
  quantity      Int           @default(1)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("KES")
  checkIn       DateTime?
  checkOut      DateTime?
  paymentRef    String?
  paymentMethod String?
  notes         String?
  /**
   * A ticket reserved with nothing charged yet — the guest pays cash or
   * M-Pesa in person at the door. Still a real, issued ticket (same
   * instant-confirm path as a free one), just flagged so door staff know
   * to collect before admitting rather than treating a scan as proof of
   * payment the way it is for every other booking.
   */
  payAtGate  Boolean   @default(false)
  gatePaidAt DateTime?
  /** User id of whoever marked it collected — usually door staff at check-in. */
  gatePaidBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  eventId        String?
  hotelId        String?
  roomId         String?
  restaurantId   String?
  ticketTierId   String?
  discountCodeId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id])
  hotel        Hotel?        @relation(fields: [hotelId], references: [id])
  room         Room?         @relation(fields: [roomId], references: [id])
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id])
  ticketTier   TicketTier?   @relation(fields: [ticketTierId], references: [id])
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])
  payments     Payment[]
  tickets      Ticket[]

  @@map("bookings")
}

// ─── Payments ────────────────────────────────────────────────────────────────
// Transaction ledger for paid bookings (currently: event tickets). One row per
// payment attempt, so a failed/expired M-Pesa push can be retried without
// losing the audit trail. Booking.paymentRef/paymentMethod are set from the
// successful Payment row once one exists.

model Payment {
  id          String          @id @default(cuid())
  bookingId   String
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("KES")
  phone       String? // M-Pesa payer phone (MSISDN)
  providerRef String? // Daraja CheckoutRequestID / Pesapal merchant reference (our own Payment id)
  receiptRef  String? // Daraja MpesaReceiptNumber / Pesapal confirmation code, set on success
  rawCallback Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([provider, providerRef])
  @@map("payments")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  /** Everything ADMIN can do, plus reviewing publicly-submitted events —
      the one queue where a wrong approval puts a fake or scam event in
      front of real guests, so it stays behind a narrower role. */
  SUPER_ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum EventCategory {
  MUSIC
  SPORTS
  ARTS
  FOOD_DRINK
  TECH
  BUSINESS
  COMEDY
  FILM
  EDUCATION
  OTHER
}

enum BookingType {
  EVENT
  HOTEL
  RESTAURANT
}

// ─── Tickets ─────────────────────────────────────────────────────────────────
// One row per admitted person, not per booking: a party of four gets four
// tickets, each independently named and each scannable exactly once. That is
// what makes a ticket transferable to a friend without handing over the whole
// booking, and what stops one screenshot admitting the entire group.
//
// No secret is stored here. The QR carries an HMAC of the ticket id signed with
// TICKET_SIGNING_SECRET, so forging one means forging the signature; this table
// only answers "has it already been used".

model Ticket {
  id           String       @id @default(cuid())
  bookingId    String
  eventId      String
  /** 1..n within the booking — printed as "Ticket 2 of 4". */
  serial       Int
  /** Who is coming. Null until the buyer names them; the ticket still admits. */
  attendeeName String?
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  /** User id of the organiser or gate staff who scanned it. */
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serial])
  @@index([eventId, status])
  @@map("tickets")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  /** Refunded, or cancelled after issue. Never admits. */
  VOID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  MPESA
  PESAPAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
